# Environment configuration for the email/ticket classifier.
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. This file is the setup contract: every environment
# variable the code reads appears here with a placeholder and a description.

# Groq API key. REQUIRED. Create one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Reasoning effort for gpt-oss-120b. OPTIONAL; defaults to "low" if unset.
# Accepts: low | medium | high. Higher effort can improve accuracy on hard
# cases but spends more tokens against Groq's per-minute token budget. The eval
# runner can override this per run.
REASONING_EFFORT=low
